        { "q": "Quyidagi so‘zlardan qaysi biri ot?", "options": ["Kitob", "Chiroyli", "Yugurmoq", "Tez"], "answer": 0, "why": "«Kitob» narsa nomini bildiradi va nima? so‘rog‘iga javob beradi." },
        { "q": "Ot qaysi so‘roqlarga javob beradi?", "options": ["qanday? qanaqa?", "kim? nima? qayer?", "nima qildi? nima qilyapti?", "qachon? qancha?"], "answer": 1, "why": "Ot shaxs, narsa va joy nomini bildiradi, shuning uchun kim? nima? qayer? so‘roqlariga javob beradi." },
        { "q": "Qaysi qatorda faqat atoqli otlar berilgan?", "options": ["daryo, shahar, shoir", "kitob, Toshkent, daftar", "Navoiy, Andijon, Sirdaryo", "bola, Amudaryo, tog‘"], "answer": 2, "why": "Navoiy, Andijon, Sirdaryo — kishi, shahar va daryoning maxsus nomlari." },
